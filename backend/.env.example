PROJECT_NAME=Café de Finca
API_PREFIX=/api

# MySQL 8. Cambiar usuario, contraseña y base según el entorno local.
DATABASE_URL=mysql+pymysql://cafe_finca:cafe_finca@localhost:3306/cafe_finca?charset=utf8mb4

# Usar una clave larga y aleatoria en producción.
JWT_SECRET_KEY=cambiar-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REFRESH_COOKIE_NAME=refresh_token
# true en producción (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=["http://localhost:3000"]

# Administrador inicial para el comando de seed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-en-produccion
ADMIN_NOMBRE=Administrador
