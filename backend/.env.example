# Configuración de ejemplo para desarrollo local (SQLite).
# Copiar a .env: cp .env.example .env
#
# Las rutas relativas de SQLite se resuelven contra backend/, por lo que
# el archivo resultante es backend/db.sqlite sin importar el cwd.
DATABASE_URL=sqlite:///./db.sqlite

SECRET_KEY=cambiar-por-una-clave-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
