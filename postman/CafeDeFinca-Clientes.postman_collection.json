      "name": "Clientes",
      "description": "Padrón de clientes del panel y autoservicio del portal. El Cliente solo puede ver y editar su propio perfil (`/clientes/me`).",
      "item": [
        {
          "name": "GET /clientes/",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/clientes/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "clientes"
              ]
