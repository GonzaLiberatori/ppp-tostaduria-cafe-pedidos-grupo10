  "item": [
    {
      "name": "Preparación",
      "description": "Ejecutá estos logins antes que el resto. Cada uno guarda su token: Administrador en `{{token}}`, Operario en `{{tokenOperario}}` y Cliente en `{{tokenCliente}}`.",
      "item": [
        {
          "name": "Login — Administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Login\n\n**Endpoint:** `POST /api/v1/auth/login`\n**Auth:** no requiere token.\n**Respuestas documentadas:** 200, 422.\n**Credenciales:** `{{adminEmail}}` / `{{adminPassword}}`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) {",
                  "    pm.collectionVariables.set(\"token\", data.access_token);",
                  "    pm.test(\"Token guardado en {{token}}\", () => pm.expect(data.access_token).to.be.a(\"string\"));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": [
            {
              "name": "Ejemplo 200",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/login",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "auth",
                    "login"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"token_type\": \"string\"\n}"
            }
          ]
        },
